{
  "name": "bank-sim",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "tsc --build",
    "build.watch": "tsc --build --watch",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "test": "mocha --exit --require ts-node/register --require source-map-support/register src/mocha/*.test.ts",
    "worker": "ts-node src/worker.ts",
    "worker.watch": "nodemon src/worker.ts",
    "portal": "ts-node src/clients/portal.ts",
    "broker": "ts-node src/clients/broker.ts",
    "aggregator": "ts-node src/clients/aggregator.ts",
    "review": "ts-node src/clients/review.ts",
    "status": "ts-node src/clients/status.ts",
    "upload-docs": "ts-node src/clients/uploadDocs.ts"
  },
  "nodemonConfig": {
    "execMap": {
      "ts": "ts-node"
    },
    "ext": "ts",
    "watch": [
      "src"
    ]
  },
  "dependencies": {
    "@temporalio/activity": "^1.25.0",
    "@temporalio/client": "^1.25.0",
    "@temporalio/common": "^1.25.0",
    "@temporalio/envconfig": "^1.25.0",
    "@temporalio/worker": "^1.25.0",
    "@temporalio/workflow": "^1.25.0"
  },
  "devDependencies": {
    "@temporalio/testing": "^1.25.0",
    "@types/mocha": "10.x",
    "@types/node": "^22.9.1",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.0",
    "mocha": "^12.0.3",
    "nodemon": "^3.1.7",
    "prettier": "^3.4.2",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3",
    "@tsconfig/node20": "^20.0.0"
  },
  "description": "Loan application orchestration on Temporal (case study)"
}
